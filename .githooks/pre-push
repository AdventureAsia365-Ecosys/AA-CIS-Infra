#!/usr/bin/env bash
# Git pre-push hook (AA-993 H1): runs scripts/pre-push.sh, the repo's CI checks for the files this push changes.
# Installed by scripts/install-hooks.sh (git config core.hooksPath .githooks). Bypass once: git push --no-verify
# Git passes <remote name> <remote url> as arguments and one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

set -uo pipefail

top=$(git rev-parse --show-toplevel) || exit 1
script="$top/scripts/pre-push.sh"
if [ ! -f "$script" ]; then
  echo "pre-push hook: $script not found on this branch; no local checks run." >&2
  exit 0
fi

head=$(git rev-parse HEAD 2>/dev/null || true)
pushes=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # A delete (all-zero local sha, SHA-1 or SHA-256) pushes no code.
  [[ "$local_sha" =~ ^0+$ ]] && continue
  pushes=$((pushes + 1))
  [ "$local_sha" = "$head" ] && continue
  # The checks run on the working tree at HEAD. That covers an ancestor of HEAD (HEAD holds all of it), not another
  # branch: fail closed rather than check the wrong tree.
  if [ -z "$head" ] || ! git merge-base --is-ancestor "$local_sha" HEAD 2>/dev/null; then
    echo "pre-push: pushing ${local_sha:0:12}, which is not HEAD or an ancestor of it; check out that branch and push again, or use git push --no-verify" >&2
    exit 1
  fi
done

if [ "$pushes" -eq 0 ]; then
  exit 0
fi

exec bash "$script"
