# Terraform
.terraform/
scripts/
# X1 S12 (AA-852): reviewed DB Migrate run-script files and the workflow helper are tracked.
!/db/scripts/
!/.github/scripts/
# AA-993 H1: the pre-push hook scripts are tracked; the rest of the root scripts/ (old one-off patches) stays ignored.
!/scripts/
/scripts/*
!/scripts/pre-push.sh
!/scripts/install-hooks.sh
!/scripts/test_git_env_isolation.py

*.tfstate
*.tfstate.backup
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# Secrets
*.pem
*.key
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json
# Terraform variable files can hold secrets: never commit one (AA-841).
*.tfvars
*.tfvars.json
**/terraform.tfvars
!*.tfvars.example
# Exception: the live root's tfvars is tracked on purpose. It holds only non-secret config; the
# secret-shaped variables are REPLACE_ME placeholders (no db_password since AA-1182: RDS manages it).
# The Secret Scan PR check (.github/workflows/secret-scan.yml) fails if a real value lands there.
!accounts/aa365/terraform.tfvars

# Terraform archive_file outputs (built at plan/apply time)
accounts/*/lambda_src/*.zip

# Local venv for the pre-push checks (scripts/install-hooks.sh --venv)
.venv/

# Python bytecode (db/ scripts, tests, identity triggers)
__pycache__/

# AA-1161: build artifacts are never committed. The live Lambdas are zipped by Terraform archive_file at plan time
# (accounts/aa365/*.tf); the retired ACP/CIS Lambda zips that sat here were removed. tools/repo/lean_guard.py refuses
# a dist/**/*.zip at push and in CI.
/dist/
