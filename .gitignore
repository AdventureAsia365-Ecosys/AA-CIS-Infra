# Terraform
.terraform/
scripts/
# X1 S12 (AA-852): reviewed DB Migrate run-script files and the workflow helper are tracked.
!/db/scripts/
!/.github/scripts/

*.tfstate
*.tfstate.backup
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# Secrets
*.pem
*.key
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json
# Terraform variable files can hold secrets: never commit one (AA-841).
*.tfvars
*.tfvars.json
**/terraform.tfvars
!*.tfvars.example
# Exception: the live root's tfvars is tracked on purpose. It holds only non-secret config; the
# secret-shaped variables are REPLACE_ME placeholders and db_password comes from TF_VAR_db_password.
# The Secret Scan PR check (.github/workflows/secret-scan.yml) fails if a real value lands there.
!accounts/aa365/terraform.tfvars

# Terraform archive_file outputs (built at plan/apply time)
accounts/*/lambda_src/*.zip

# Python bytecode (db/ scripts, tests, identity triggers)
__pycache__/
