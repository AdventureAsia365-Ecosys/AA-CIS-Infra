{
  "Comment": "AA-CIS Tour Content Pipeline — S11 Phase 4",
  "StartAt": "ProcessTours",
  "States": {
    "ProcessTours": {
      "Type": "Map",
      "ItemsPath": "$.tours",
      "MaxConcurrency": 10,
      "Iterator": {
        "StartAt": "SEOIntelligence",
        "States": {
          "SEOIntelligence": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${seo_lambda_arn}",
              "Payload.$": "$$"
            },
            "ResultPath": "$.seo_result",
            "Retry": [{
              "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
              "IntervalSeconds": 2,
              "MaxAttempts": 3,
              "BackoffRate": 2.0
            }],
            "Catch": [{
              "ErrorEquals": ["States.ALL"],
              "Next": "SEOFailed",
              "ResultPath": "$.error"
            }],
            "Next": "ContentGeneration"
          },

          "SEOFailed": {
            "Type": "Pass",
            "Result": {"seo_status": "failed_continuing"},
            "ResultPath": "$.seo_result",
            "Next": "ContentGeneration",
            "Comment": "SEO failure is non-fatal — content gen proceeds without SEO boost"
          },

          "ContentGeneration": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "Cluster": "${ecs_cluster_arn}",
              "TaskDefinition": "${ecs_task_definition_arn}",
              "LaunchType": "FARGATE",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ${subnets_json},
                  "SecurityGroups": ["${sg_app_id}"],
                  "AssignPublicIp": "DISABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [{
                  "Name": "${ecs_container_name}",
                  "Environment": [
                    {"Name": "PIPELINE_MODE",       "Value": "step_functions"},
                    {"Name": "TOUR_ID",              "Value.$": "$.tour_id"},
                    {"Name": "BATCH_ID",             "Value.$": "$.batch_id"},
                    {"Name": "TENANT_ID",            "Value.$": "$.tenant_id"},
                    {"Name": "RETRY_COUNT",          "Value.$": "States.JsonToString($.retry_count)"},
                    {"Name": "VALIDATION_FEEDBACK",  "Value.$": "States.JsonToString($.validation_feedback)"}
                  ]
                }]
              }
            },
            "ResultPath": "$.content_result",
            "Retry": [{
              "ErrorEquals": ["States.TaskFailed"],
              "IntervalSeconds": 30,
              "MaxAttempts": 2,
              "BackoffRate": 2.0
            }],
            "Catch": [{
              "ErrorEquals": ["States.ALL"],
              "Next": "ContentGenFailed",
              "ResultPath": "$.error"
            }],
            "Next": "Validation"
          },

          "ContentGenFailed": {
            "Type": "Fail",
            "Error": "ContentGenerationFailed",
            "Cause": "ECS task failed after retries"
          },

          "Validation": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${validation_lambda_arn}",
              "Payload.$": "$$"
            },
            "ResultPath": "$.validation_result",
            "Retry": [{
              "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
              "IntervalSeconds": 2,
              "MaxAttempts": 2,
              "BackoffRate": 2.0
            }],
            "Catch": [{
              "ErrorEquals": ["States.ALL"],
              "Next": "ValidationFailed",
              "ResultPath": "$.error"
            }],
            "Next": "CheckQualityScore"
          },

          "ValidationFailed": {
            "Type": "Fail",
            "Error": "ValidationFailed",
            "Cause": "Validation Lambda error"
          },

          "CheckQualityScore": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.validation_result.Payload.score_overall",
                "NumericGreaterThanEquals": 7.0,
                "Next": "Export"
              },
              {
                "And": [
                  {
                    "Variable": "$.validation_result.Payload.score_overall",
                    "NumericLessThan": 7.0
                  },
                  {
                    "Variable": "$.retry_count",
                    "NumericLessThan": 3
                  }
                ],
                "Next": "PrepareRetry"
              }
            ],
            "Default": "HITLWait"
          },

          "PrepareRetry": {
            "Type": "Pass",
            "Parameters": {
              "tour_id.$":             "$.tour_id",
              "batch_id.$":            "$.batch_id",
              "tenant_id.$":           "$.tenant_id",
              "seo_result.$":          "$.seo_result",
              "retry_count.$":         "States.MathAdd($.retry_count, 1)",
              "validation_feedback.$": "$.validation_result.Payload.failed_rules"
            },
            "Next": "ContentGeneration"
          },

          "HITLWait": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
            "Parameters": {
              "FunctionName": "${validation_lambda_arn}",
              "Payload": {
                "action": "hitl_notify",
                "task_token.$": "$$.Task.Token",
                "tour_id.$":    "$.tour_id",
                "tenant_id.$":  "$.tenant_id",
                "score.$":      "$.validation_result.Payload.score_overall",
                "failed_rules.$": "$.validation_result.Payload.failed_rules"
              }
            },
            "HeartbeatSeconds": 86400,
            "ResultPath": "$.hitl_result",
            "Catch": [{
              "ErrorEquals": ["States.HeartbeatTimeout"],
              "Next": "HITLTimeout",
              "ResultPath": "$.error"
            }],
            "Next": "HITLDecision"
          },

          "HITLTimeout": {
            "Type": "Pass",
            "Result": {"decision": "approved", "reason": "timeout_auto_approve"},
            "ResultPath": "$.hitl_result",
            "Next": "Export"
          },

          "HITLDecision": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.hitl_result.decision",
                "StringEquals": "approved",
                "Next": "Export"
              },
              {
                "Variable": "$.hitl_result.decision",
                "StringEquals": "regenerate",
                "Next": "PrepareRetry"
              }
            ],
            "Default": "TourRejected"
          },

          "TourRejected": {
            "Type": "Fail",
            "Error": "TourRejectedByReviewer",
            "Cause": "Human reviewer rejected the tour content"
          },

          "Export": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${export_lambda_arn}",
              "Payload.$": "$$"
            },
            "ResultPath": "$.export_result",
            "Retry": [{
              "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
              "IntervalSeconds": 5,
              "MaxAttempts": 3,
              "BackoffRate": 2.0
            }],
            "Catch": [{
              "ErrorEquals": ["States.ALL"],
              "Next": "ExportFailed",
              "ResultPath": "$.error"
            }],
            "Next": "TourComplete"
          },

          "ExportFailed": {
            "Type": "Fail",
            "Error": "ExportFailed",
            "Cause": "Export Lambda error after retries"
          },

          "TourComplete": {
            "Type": "Succeed"
          }
        }
      },
      "ResultPath": "$.map_results",
      "Next": "BatchComplete"
    },

    "BatchComplete": {
      "Type": "Succeed"
    }
  }
}
