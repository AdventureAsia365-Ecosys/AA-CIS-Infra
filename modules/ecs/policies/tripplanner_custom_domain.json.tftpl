{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequestTaggedDnsCertificatesInUsEast1",
      "Effect": "Allow",
      "Action": ["acm:RequestCertificate"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/${tag_key}": "${tag_value}",
          "acm:ValidationMethod": "DNS"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ${tag_keys}
        }
      }
    },
    {
      "Sid": "TagRequestedCertificatesWithTheJobTag",
      "Effect": "Allow",
      "Action": ["acm:AddTagsToCertificate"],
      "Resource": "arn:aws:acm:us-east-1:${account_id}:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/${tag_key}": "${tag_value}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ${tag_keys}
        }
      }
    },
    {
      "Sid": "ReadAndDeleteOwnCertificates",
      "Effect": "Allow",
      "Action": ["acm:DescribeCertificate", "acm:DeleteCertificate"],
      "Resource": "arn:aws:acm:us-east-1:${account_id}:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/${tag_key}": "${tag_value}"
        }
      }
    },
    {
      "Sid": "AttachAliasesToTheAgencyDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:GetDistribution", "cloudfront:UpdateDistribution"],
      "Resource": "${distribution_arn}"
    },
    {
      "Sid": "NeverTagOrDeleteTerraformCertificates",
      "Effect": "Deny",
      "Action": ["acm:AddTagsToCertificate", "acm:RemoveTagsFromCertificate", "acm:DeleteCertificate"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "NeverTagOrDeleteTheProtectedCertificates",
      "Effect": "Deny",
      "Action": ["acm:AddTagsToCertificate", "acm:RemoveTagsFromCertificate", "acm:DeleteCertificate"],
      "Resource": ${protected_cert_arns}
    }
  ]
}
